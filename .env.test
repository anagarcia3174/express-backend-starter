# Server Configuration
PORT=3000
NODE_ENV=test

# JWT Secrets
ACCESS_TOKEN_SECRET=test-access-secret
REFRESH_TOKEN_SECRET=test-refresh-secret
EMAIL_VERIFICATION_TOKEN_SECRET=test-email-verification-secret
RESET_PASSWORD_TOKEN_SECRET=test-password-reset-secret

# Database Configuration
MONGO_URL=mongodb://localhost:27017/test_db
MONGO_TEST_URL=mongodb://localhost:27017/test_db


# Email Configuration
EMAIL_FROM=your-email@example.com
VERIFICATION_LINK=http://localhost:3000/api/auth/verify-email
RESET_LINK=http://localhost:3000/api/auth/reset-password

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region